            const existingSamples = cart.filter(i => i.type === 'sample').length;
            if (existingSamples >= 4) {
                showToast('Maximum 4 échantillons par commande.');
                toggleCart(true);
                return;
            }

            cart.push({
                uid: Date.now(),
                type: 'sample',
                title: `Échantillon : ${p.name}`,
                detail: `Format découpé • 100% remboursé en avoir sur commande`,
                price: 5.00
            });

            renderCart();
            showToast(`Échantillon ${p.name} ajouté (5 € remboursés).`);
        }

        function addSampleFromModal() {
            if (!activeProduct) return;
            addSampleDirectly(activeProduct.id);
            closeProductModal();
