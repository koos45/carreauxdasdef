            const publishBtn = document.getElementById('adm-publish-btn');
            if (publishBtn?.disabled) return;
            if (publishBtn) { publishBtn.disabled = true; publishBtn.textContent = existingId ? 'Mise à jour en cours…' : 'Publication en cours…'; }
            try {
                const saved = await publishProductOnline(newProduct);
                const idx = products.findIndex(p => p.id === saved.id);
                if (idx !== -1) products[idx] = saved;
                else products.unshift(saved);
                setCatalogStatus(existingId
                    ? 'Modifications enregistrées en ligne. Elles sont visibles immédiatement par tous vos clients.'
