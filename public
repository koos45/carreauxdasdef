        function recalculateModal() {
            if (!activeProduct) return;
            const rawSqm = Math.max(1, parseFloat(document.getElementById('calc-surface').value) || 1);
            const addMargin = document.getElementById('calc-margin').checked;
            
            const targetSqm = addMargin ? rawSqm * 1.10 : rawSqm;
            const boxes = Math.ceil(targetSqm / activeProduct.boxSqm);
            const realSqm = boxes * activeProduct.boxSqm;
            
            const unitPrice = modalMode === 'supply' ? activeProduct.priceSupply : activeProduct.pricePose;
            const total = realSqm * unitPrice;

            document.getElementById('calc-boxes').textContent = boxes;
            document.getElementById('calc-real-sqm').textContent = realSqm.toFixed(2).replace('.', ',');
            document.getElementById('calc-total-price').textContent = total.toFixed(2).replace('.', ',') + ' €';
        }

        // --- GESTION DU PANIER & DEVIS ---
        function addProductToCart() {
            if (!activeProduct) return;
            const boxes = parseInt(document.getElementById('calc-boxes').textContent);
            const realSqm = boxes * activeProduct.boxSqm;
            const unitPrice = modalMode === 'supply' ? activeProduct.priceSupply : activeProduct.pricePose;
            const total = realSqm * unitPrice;

            cart.push({
                uid: Date.now(),
                type: 'tile',
                title: `${activeProduct.name} (${activeProduct.format})`,
                detail: `${boxes} cartons (${realSqm.toFixed(2).replace('.', ',')} m²) • ${modalMode === 'supply' ? 'Livraison seule TVA 20%' : 'Avec forfait pose TVA 10%'}`,
                price: total
            });

            closeProductModal();
            renderCart();
            showToast(`${activeProduct.name} (${boxes} cartons) ajouté à votre sélection.`);
        }

        function addSampleDirectly(productId) {
            const p = products.find(item => item.id === productId);
