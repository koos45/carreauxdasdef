                                    <button type="button" onclick="adminDeleteQuote('${esc(q.id)}')" class="text-rose-700 hover:underline font-semibold">Supprimer</button>
                                </div>
                            </div>
                            <pre class="whitespace-pre-wrap font-sans text-[11px] text-stone-700 bg-white p-2.5 rounded-lg border border-stone-200/80">${esc(q.detail)}</pre>
                            <div class="text-right font-bold text-stone-900">Total estimé : ${esc(q.totalEstime)}</div>
                        </div>
                    `;
                }).join('');
            } catch (e) {
                list.innerHTML = `<p class="text-rose-700 bg-rose-50 p-3 rounded-xl border border-rose-200">Impossible de charger les devis : ${e.message}</p>`;
            }
        }

        async function adminDeleteQuote(id) {
            if (!confirm('Supprimer cette demande de devis ?')) return;
            try {
                await adminApi('DELETE', `/api/admin/quotes/${encodeURIComponent(id)}`);
                loadAdminQuotes();
                showToast('Demande de devis supprimée.');
            } catch (e) {
                showToast(`Erreur : ${e.message}`);
            }
        }

        function exportPublishedHtmlForNetlify() {
            const docClone = document.documentElement.cloneNode(true);
            const adminModalClone = docClone.querySelector('#admin-modal');
            if (adminModalClone) adminModalClone.classList.add('hidden');
            const productModalClone = docClone.querySelector('#product-modal');
            if (productModalClone) productModalClone.classList.add('hidden');
            const cartDrawerClone = docClone.querySelector('#cart-drawer');
            if (cartDrawerClone) cartDrawerClone.classList.add('hidden');
            const toastClone = docClone.querySelector('#toast');
            if (toastClone) toastClone.classList.add('hidden');
            docClone.querySelector('#delivery-form')?.classList.add('hidden');
            docClone.querySelector('#checkout-error-box')?.classList.add('hidden');
            const methodClone = docClone.querySelector('#checkout-method');
            if (methodClone) methodClone.querySelectorAll('option').forEach(o => o.removeAttribute('selected'));
            docClone.querySelector('#home-hero')?.classList.remove('hidden');
            docClone.querySelector('#category-hero')?.classList.add('hidden');
            if (window.__homeMeta) {
                const hm = window.__homeMeta;
                const t = docClone.querySelector('title'); if (t) t.textContent = hm.title;
                docClone.querySelector('meta[name="description"]')?.setAttribute('content', hm.desc);
                docClone.querySelector('link[rel="canonical"]')?.setAttribute('href', hm.canonical);
                docClone.querySelector('meta[property="og:url"]')?.setAttribute('content', hm.ogUrl);
            }

            const serializedProducts = JSON.stringify(products, null, 12);
            const serializedSupplies = JSON.stringify(supplies, null, 12);
            let fullHtml = '<!DOCTYPE html>\n' + docClone.outerHTML;
            fullHtml = fullHtml.replace(
                /let products = \[[\s\S]*?\n        \];/,
                `let products = ${serializedProducts};`
            );
            fullHtml = fullHtml.replace(
                /let supplies = \[[\s\S]*?\n        \];/,
                `let supplies = ${serializedSupplies};`
            );

            const blob = new Blob([fullHtml], { type: 'text/html;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'index.html';
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
            showToast('Fichier index.html téléchargé.');
        }

        function adminSaveSettings() {
            adminSettings.stripeUrl = document.getElementById('adm-stripe-url').value.trim();
            adminSettings.iban = document.getElementById('adm-iban').value.trim();
            try {
                localStorage.setItem('carreauxdas_admin_settings', JSON.stringify(adminSettings));
            } catch (e) {
                console.error(e);
            }
            updateCheckoutInfo();
            closeAdminModal();
            showToast('Paramètres de paiement SARL mis à jour.');
        }

        // --- TOAST MESSAGE ---
        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = msg;
            toast.classList.remove('hidden');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('hidden');
            }, 3500);
        }
    </script>

