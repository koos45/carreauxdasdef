        async function adminApi(method, url, body) {
            const send = () => fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json', 'x-admin-password': adminOnlinePassword },
                body: body === undefined ? undefined : JSON.stringify(body)
            });
            let res = await send();
            if (res.status === 401) {
                const pass = window.prompt("Mot de passe gérant en ligne (configuré dans l'espace Netlify) :");
                if (!pass) throw new Error('Mot de passe en ligne requis pour publier.');
                adminOnlinePassword = pass.trim();
                res = await send();
            }
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || `Erreur serveur (${res.status})`);
            return data;
        }

        async function uploadPhotoIfNeeded(src) {
            if (typeof src !== 'string' || !src.startsWith('data:')) return src;
            const { url } = await adminApi('POST', '/api/admin/photos', { dataUrl: src });
            return url;
        }

        async function publishProductOnline(product) {
            const images = [];
            for (const src of product.images || []) images.push(await uploadPhotoIfNeeded(src));
            return adminApi('POST', '/api/admin/products', { ...product, images });
        }

        async function syncLocalDataOnline() {
            if (syncingLocalData) return;
            let localProducts = [];
            let localStock = {};
            try {
                localProducts = JSON.parse(localStorage.getItem('carreauxdas_custom_products') || '[]');
                localStock = JSON.parse(localStorage.getItem('carreauxdas_stock_overrides') || '{}');
            } catch (e) {}
            if (!Array.isArray(localProducts)) localProducts = [];
            if (!localStock || typeof localStock !== 'object' || Array.isArray(localStock)) localStock = {};
            if (localProducts.length === 0 && Object.keys(localStock).length === 0) return;

            showToast('Publication en ligne des modèles enregistrés sur cet appareil…');
            syncingLocalData = true;
            const remaining = [...localProducts];
            let published = 0;
            for (const lp of [...localProducts].reverse()) {
                try {
                    const saved = await publishProductOnline(lp);
                    const idx = products.findIndex(p => p.id === saved.id);
                    if (idx !== -1) products[idx] = saved; else products.unshift(saved);
                    remaining.splice(remaining.indexOf(lp), 1);
                    try { localStorage.setItem('carreauxdas_custom_products', JSON.stringify(remaining)); } catch (e) {}
                    published++;
                } catch (e) {
                    if (/mot de passe|non configuré|incorrect/i.test(e.message)) { showToast(e.message); break; }
                }
            }
            const leftover = remaining;
            const stockLeft = {};
            for (const [id, val] of Object.entries(localStock)) {
                try { await adminApi('PUT', `/api/admin/stock/${encodeURIComponent(id)}`, { inStock: val }); }
                catch (e) { stockLeft[id] = val; }
            }
            try {
                if (leftover.length) localStorage.setItem('carreauxdas_custom_products', JSON.stringify(leftover));
                else localStorage.removeItem('carreauxdas_custom_products');
                if (Object.keys(stockLeft).length) localStorage.setItem('carreauxdas_stock_overrides', JSON.stringify(stockLeft));
                else localStorage.removeItem('carreauxdas_stock_overrides');
            } catch (e) {}
            syncingLocalData = false;
            renderProducts();
            renderAdminStockList();
            if (leftover.length === 0 && Object.keys(stockLeft).length === 0) {
                showToast(published > 0
                    ? `${published} modèle(s) publié(s) en ligne : ils sont maintenant visibles par tous vos clients.`
                    : 'Statuts de stock publiés en ligne pour tous vos clients.');
            } else {
                showToast(`Certains éléments n'ont pas pu être publiés (${leftover.length} modèle(s)). Ils seront réessayés à la prochaine connexion.`);
            }
        }

