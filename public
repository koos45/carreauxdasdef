        function stepSupplyQty(supplyId, delta) {
            const input = document.getElementById(`sup-qty-${supplyId}`);
            if (!input) return;
            const current = Math.max(1, parseInt(input.value, 10) || 1);
            input.value = Math.min(500, Math.max(1, current + delta));
        }

