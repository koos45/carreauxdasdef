            const norm = document.getElementById('adm-norm')?.value.trim() || 'R10 • 1er Choix Rectifié';
            const customDesc = document.getElementById('adm-desc')?.value.trim();

            if (!name) {
                showToast('Veuillez renseigner le nom du modèle.');
                return;
            }

            const productImages = adminUploadedImages.length > 0
                ? [...adminUploadedImages]
                : (existingProduct?.images?.length ? [...existingProduct.images] : ['https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1600&q=85']);

            const newProduct = {
                id: existingId || ('custom-' + Date.now()),
                name: name,
                category: cat,
                format: format,
                discount: existingProduct?.discount || '-30%',
                oldPrice: +(price * 1.42).toFixed(2),
                priceSupply: price,
                pricePose: +(price * 0.916).toFixed(2),
                boxSqm: boxSqm,
                norm: norm,
                inStock: document.getElementById('adm-in-stock')?.checked ?? true,
                images: productImages,
                desc: customDesc || 'Nouveau modèle ajouté au catalogue direct négoce Carreaux Das SARL. Grès cérame 1er choix rectifié.'
