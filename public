        async function loadOnlineCatalog() {
            try {
                const res = await fetch('/api/catalog', { cache: 'no-store' });
                if (!res.ok) throw new Error('Catalogue indisponible');
                const { products: online = [], stock = {}, hiddenIds = [], supplies: onlineSupplies = [] } = await res.json();
                const hiddenSet = new Set(hiddenIds);
                products = products.filter(p => !hiddenSet.has(p.id));
                const existingIds = new Set(products.map(p => p.id));
                const newOnes = online.filter(p => p && p.id && !hiddenSet.has(p.id) && !existingIds.has(p.id));
                online.forEach(op => {
                    const idx = products.findIndex(p => p.id === op.id);
                    if (idx !== -1) products[idx] = op;
                });
                if (newOnes.length > 0) products.unshift(...newOnes);
                products.forEach(p => {
                    if (Object.prototype.hasOwnProperty.call(stock, p.id)) p.inStock = Boolean(stock[p.id]);
                });
                onlineSupplies.forEach(os => {
                    const idx = supplies.findIndex(s => s.id === os.id);
                    const normalized = {
                        ...os,
                        domain: os.domain || os.desc || '',
                        specs: os.specs || ''
                    };
                    if (idx !== -1) supplies[idx] = Object.assign({}, supplies[idx], normalized);
                    else supplies.push(normalized);
                });
                renderProducts();
                renderSupplies();
                renderAdminStockList();
                renderAdminSuppliesList();
                setCatalogStatus('Catalogue en ligne accessible. Les publications confirmées sont enregistrées durablement.');
                return true;
            } catch (e) {
                setCatalogStatus('Catalogue en ligne indisponible. Les modèles enregistrés ne peuvent pas être chargés pour le moment. Réessayez dans quelques instants.');
                return false;
            }
        }

