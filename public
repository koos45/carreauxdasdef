            const qtyInput = document.getElementById(`sup-qty-${supplyId}`);
            const qty = Math.max(1, parseInt(qtyInput?.value, 10) || 1);
            const unitPrice = Number(s.price);
            const lineTotal = +(unitPrice * qty).toFixed(2);

            cart.push({
                uid: Date.now(),
                type: 'supply',
                title: qty > 1 ? `${s.name} (x${qty})` : s.name,
                detail: `${qty} unité(s) × ${unitPrice.toFixed(2).replace('.', ',')} € • ${s.subtitle}`,
                price: lineTotal
            });

            if (qtyInput) qtyInput.value = '1';
            renderCart();
            showToast(`${qty} × ${s.name} ajouté au panier.`);
        }

