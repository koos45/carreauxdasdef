        const FREE_SHIPPING_THRESHOLD = 900;
        function updateFreeShipping(total) {
            const shippingEl = document.getElementById('cart-shipping');
            const msgEl = document.getElementById('free-shipping-msg');
            const barEl = document.getElementById('free-shipping-bar');
            if (!shippingEl || !msgEl || !barEl) return;
            const pct = Math.min(100, Math.round((total / FREE_SHIPPING_THRESHOLD) * 100));
            barEl.style.width = pct + '%';
            if (total >= FREE_SHIPPING_THRESHOLD) {
                shippingEl.innerHTML = '<strong class="text-emerald-700">Gratuite</strong>';
                msgEl.textContent = 'Bravo ! La livraison vous est offerte.';
            } else {
                shippingEl.textContent = 'Calculée selon département';
                const remaining = (FREE_SHIPPING_THRESHOLD - total).toFixed(2).replace('.', ',');
                msgEl.textContent = total > 0
                    ? `Plus que ${remaining} € pour profiter de la livraison gratuite`
                    : 'Livraison gratuite dès 900 € d\'achat';
            }
        }

