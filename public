            resetAdminProductForm();
            renderProducts();
            renderAdminStockList();
            showToast(existingId
                ? `Modèle « ${name} » mis à jour !`
                : `Modèle « ${name} » publié ! Il est visible tout de suite par tous vos clients.`);
