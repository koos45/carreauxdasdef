        function getDeliveryInfo() {
            const val = id => (document.getElementById(id)?.value || '').trim();
            return {
                firstName: val('dlv-firstname'),
                lastName: val('dlv-lastname'),
                email: val('dlv-email').replace(/\s+/g, ''),
                phone: val('dlv-phone'),
                address: val('dlv-address'),
                address2: val('dlv-address2'),
                zip: val('dlv-zip').replace(/\s+/g, ''),
                city: val('dlv-city'),
                notes: val('dlv-notes')
            };
        }

        function validateDeliveryInfo() {
            const d = getDeliveryInfo();
            const zipInput = document.getElementById('dlv-zip');
            if (zipInput) zipInput.value = d.zip;

            const errors = [];
            const mark = (id, bad) => {
                const el = document.getElementById(id);
                if (!el) return;
                el.classList.toggle('border-rose-500', bad);
                el.classList.toggle('bg-rose-50', bad);
                el.classList.toggle('border-stone-200', !bad);
                el.classList.toggle('bg-stone-50', !bad);
            };
            const checks = [
                ['dlv-firstname', d.firstName.length >= 1, 'prénom'],
                ['dlv-lastname', d.lastName.length >= 1, 'nom'],
                ['dlv-email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(d.email), 'email valide'],
                ['dlv-phone', d.phone.replace(/[^0-9]/g, '').length >= 10, 'téléphone (10 chiffres)'],
                ['dlv-address', d.address.length >= 4, 'adresse complète'],
                ['dlv-zip', /^[0-9]{5}$/.test(d.zip) && !/^(97|98)/.test(d.zip), 'code postal (5 chiffres, France métropolitaine)'],
                ['dlv-city', d.city.length >= 2, 'ville']
            ];
            checks.forEach(([id, ok, label]) => {
                mark(id, !ok);
                if (!ok) errors.push(label);
            });
            if (errors.length > 0) {
                const msg = 'Informations de livraison à compléter : ' + errors.join(', ') + '.';
                showCheckoutError(msg);
                showToast(msg);
                const firstBad = checks.find(c => !c[1]);
                document.getElementById(firstBad[0])?.focus();
                return null;
            }
            showCheckoutError('');
            try { localStorage.setItem('carreauxdas_delivery_info', JSON.stringify(d)); } catch (e) {}
            return d;
        }

        function restoreDeliveryInfo() {
            try {
                const saved = JSON.parse(localStorage.getItem('carreauxdas_delivery_info') || 'null');
                if (!saved) return;
                const map = { firstName: 'dlv-firstname', lastName: 'dlv-lastname', email: 'dlv-email', phone: 'dlv-phone', address: 'dlv-address', address2: 'dlv-address2', zip: 'dlv-zip', city: 'dlv-city', notes: 'dlv-notes' };
                Object.entries(map).forEach(([k, id]) => {
                    const el = document.getElementById(id);
                    if (el && saved[k]) el.value = saved[k];
                });
            } catch (e) {}
        }

        async function submitOrderOrQuote() {
            showCheckoutError('');
            if (cart.length === 0) {
                showCheckoutError('Ajoutez au moins un article ou un échantillon avant de valider.');
                return;
            }
            const method = document.getElementById('checkout-method').value;
            if (method === 'devis') {
                const contact = document.getElementById('client-contact')?.value.trim();
                const clientName = document.getElementById('client-name-quote')?.value.trim() || 'Non renseigné';
                const clientCity = document.getElementById('client-city-quote')?.value.trim() || 'Non renseignée';
                if (!contact) {
                    showCheckoutError('Veuillez indiquer votre email ou téléphone pour recevoir le devis.');
                    document.getElementById('client-contact')?.focus();
                    return;
                }
                const totalAmount = cart.reduce((sum, item) => sum + (Number(item.price) || 0), 0);
                const linesText = cart.map((item, idx) =>
                    `${idx + 1}. ${item.title} — ${item.detail} (${item.price > 0 ? item.price.toFixed(2).replace('.', ',') + ' € TTC' : 'Sur devis'})`
                ).join('\n');

                const totalEstimeStr = totalAmount > 0 ? `${totalAmount.toFixed(2).replace('.', ',')} € TTC` : 'À chiffrer sur devis';

                try {
                    const res = await fetch('/api/quotes', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            clientName,
                            clientContact: contact,
                            clientCity,
                            totalEstime: totalEstimeStr,
                            detail: linesText
                        })
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) throw new Error(data.error || 'Erreur serveur');
                    showToast('Demande de devis enregistrée et transmise à Carreaux Das SARL ! Réponse sous 24h.');
                    cart = [];
                    renderCart();
                    toggleCart(false);
                } catch (err) {
                    showCheckoutError('Impossible d\'envoyer la demande pour le moment. Vous pouvez aussi nous joindre directement au 07 80 51 33 92 ou à koos45120@gmail.com.');
                }
            } else if (method === 'card') {
                const payableItems = cart.filter(i => i.price > 0);
                if (payableItems.length === 0) {
                    showCheckoutError('Votre sélection contient uniquement une étude sur devis (0 €). Choisissez « Demande de Devis gratuit sous 24h » dans le menu déroulant ci-dessus.');
                    return;
                }
                const delivery = validateDeliveryInfo();
                if (!delivery) return;
                const contact = delivery.email;
                showToast('Création de votre session de paiement sécurisée Stripe...');
                try {
                    const response = await fetch('/.netlify/functions/create-checkout', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            items: payableItems,
                            customerContact: contact,
                            delivery: delivery,
                            successUrl: window.location.origin + window.location.pathname + '?payment=success',
                            cancelUrl: window.location.origin + window.location.pathname + '?payment=cancel'
                        })
                    });
                    const data = await response.json();
                    if (response.ok && data.url) {
                        window.location.href = data.url;
                        return;
                    } else {
                        throw new Error(data.error || 'Configuration Stripe serveur requise');
                    }
                } catch (err) {
                    console.warn('Stripe Checkout function error:', err);
                    if (adminSettings.stripeUrl && /^https:\/\/(buy\.stripe\.com|checkout\.stripe\.com|pay\.sumup\.com)\//.test(adminSettings.stripeUrl)) {
                        showToast('Redirection vers le paiement sécurisé Stripe...');
                        const fallbackUrl = new URL(adminSettings.stripeUrl);
                        if (fallbackUrl.hostname === 'buy.stripe.com') fallbackUrl.searchParams.set('prefilled_email', contact);
                        window.location.href = fallbackUrl.toString();
                        return;
                    }
                    showCheckoutError('Paiement CB momentanément indisponible : utilisez « Demande de Devis » ou le virement bancaire.');
                }
            } else {
                if (!validateDeliveryInfo()) return;
                showToast('Votre commande est enregistrée en attente de virement SARL.');
            }
        }

        // --- SIMULATEUR D'ÉCONOMIES ---
        function setSimSurface(val) {
            document.getElementById('surface-slider').value = val;
            updateSimulator(val);
        }

